# LLM settings

# Model config (litellm format - see https://docs.litellm.ai/docs/providers)
# PRO_MODEL=gemini/gemini-3-pro-preview        # smart model
# PRO_MODEL=moonshot/kimi-k2-5                 # Moonshot AI alternative
# PRO_MODEL=openrouter/google/gemini-3-pro-preview  # if using openrouter
# FLASH_MODEL=gemini/gemini-3-flash-preview    # fast model
# FLASH_MODEL=moonshot/kimi-k2-5               # Moonshot AI alternative
# EMBEDDING_MODEL=gemini/text-embedding-004

# Output token cap for LiteLLM/OpenRouter requests
# MAX_TOKENS=16384
# MAX_OUTPUT_TOKENS=16384  # alias for MAX_TOKENS

# API keys (set for your provider - litellm reads from env)
GEMINI_API_KEY=your-key
# GOOGLE_API_KEY=your-key  # alternative to GEMINI_API_KEY (for backward compat)
# MOONSHOT_API_KEY=your-key
# OPENROUTER_API_KEY=your-key
# OPENAI_API_KEY=your-key
# ANTHROPIC_API_KEY=your-key

# Logging
# LOG_LEVEL=WARNING          # hr-breaker logger
# LOG_LEVEL_GENERAL=WARNING  # global

# Filter thresholds
# FILTER_HALLUCINATION_THRESHOLD=0.9
# FILTER_KEYWORD_THRESHOLD=0.25
# FILTER_LLM_THRESHOLD=0.7
# FILTER_VECTOR_THRESHOLD=0.4
# FILTER_AI_GENERATED_THRESHOLD=0.4

# Resume length limits
# RESUME_MAX_CHARS=4500
# RESUME_MAX_WORDS=520
# RESUME_PAGE2_OVERFLOW_CHARS=1000

# Keyword matcher
# KEYWORD_TFIDF_MAX_FEATURES=200
# KEYWORD_TFIDF_CUTOFF=0.1
# KEYWORD_MAX_MISSING_DISPLAY=10

# Embedding settings
# EMBEDDING_OUTPUT_DIMENSIONALITY=768

# Agent limits
# AGENT_NAME_EXTRACTOR_CHARS=2000

# Language (resume output language)
# DEFAULT_LANGUAGE=from_job
# FILTER_TRANSLATION_THRESHOLD=1.0

# Retry settings (for rate limits / transient errors)
# RETRY_MAX_ATTEMPTS=5
# RETRY_MAX_WAIT=60
# LLM_MAX_CONCURRENCY=8   # lower this if your provider caps concurrent requests (e.g. 1)
# LLM_CALL_TIMEOUT=300    # per-attempt timeout in seconds (one agent.run() call, which can be
                          # several tool-calling round-trips, not one completion); a hang counts
                          # as a retryable failure instead of blocking forever
# LLM_MIN_CALL_INTERVAL=0 # minimum seconds between calls; raise if a provider's own concurrency
                          # slot release lags behind ours (back-to-back calls still get 429'd)
# MOONSHOT_DISABLE_THINKING=true  # sends thinking:disabled to moonshot/kimi models - they run
                                  # extended reasoning by default, which is pure latency/token
                                  # cost for structured-extraction tasks that don't need it

# CLI options (overridden by command-line flags)
# HR_BREAKER_OUTPUT=output
# HR_BREAKER_MAX_ITERATIONS=5
# HR_BREAKER_DEBUG=false
# HR_BREAKER_SEQ=false
# HR_BREAKER_NO_SHAME=false
